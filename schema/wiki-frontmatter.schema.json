{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ACAZUMAH/my-obsidian-vault/schema/wiki-frontmatter.schema.json",
  "title": "LLM Wiki Page Frontmatter",
  "type": "object",
  "required": [
    "type",
    "status",
    "created",
    "updated",
    "tags",
    "sources"
  ],
  "properties": {
    "type": {
      "enum": [
        "source",
        "concept",
        "entity",
        "project",
        "question",
        "synthesis",
        "template"
      ]
    },
    "status": {
      "enum": [
        "seed",
        "active",
        "needs-review",
        "superseded"
      ]
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    }
  },
  "additionalProperties": true
}
